{
  "name": "cookbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write .",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "e2e:install-browsers": "npx playwright install --with-deps",
    "e2e:test": "npx playwright test --reporter=list",
    "e2e:report": "npx playwright test",
    "verify": "npm run build && npm run lint:check && npm run coverage && npm run mutation && npm run e2e:test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
